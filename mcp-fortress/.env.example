# Copy to .env (prod) or .env.dev (local) — never commit the real file.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
FORTRESS_MCP_EMAIL=<dedicated staff user email>
FORTRESS_MCP_PASSWORD=<that user password>
# Optional
FORTRESS_MCP_DATA_DIR=./data
FORTRESS_CLIENT_NAME=Fortress_Fund
# FORTRESS_MCP_TOKEN_SECRET=  (unset = random per process; tokens die on restart)
