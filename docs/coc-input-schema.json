{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/coc-input-schema.json",
  "title": "COC Verification Input Schema",
  "description": "JSON Schema for validating Electrical Certificate of Compliance test data input",
  "type": "object",
  "required": ["cocNumber", "cocType", "installationType", "premise", "registeredPerson", "testResults", "circuits"],
  "properties": {
    "cocNumber": {
      "type": "string",
      "description": "Unique COC reference number",
      "pattern": "^[A-Z]{2,4}-\\d{4}-\\d{6}$",
      "examples": ["ECA-2024-001234", "ECSA-2024-005678"]
    },
    "cocType": {
      "type": "string",
      "enum": ["ECA", "ECSA", "Other"],
      "description": "Type of issuing authority"
    },
    "installationType": {
      "type": "string",
      "description": "Classification of installation",
      "examples": ["Domestic Single Phase", "Domestic Three Phase", "Commercial", "Industrial"]
    },
    "premise": {
      "type": "object",
      "required": ["address", "supplyType", "nominalVoltage", "phases"],
      "properties": {
        "address": {
          "type": "string",
          "description": "Full physical address"
        },
        "erfNumber": {
          "type": "string",
          "description": "Erf or lot number",
          "pattern": "^ERF\\s\\d+$"
        },
        "supplyType": {
          "type": "string",
          "enum": ["TN-S", "TN-C", "TN-C-S", "TT", "IT"],
          "description": "Earthing system type per SANS 10142-1"
        },
        "nominalVoltage": {
          "type": "number",
          "minimum": 220,
          "maximum": 240,
          "description": "Nominal supply voltage in volts"
        },
        "phases": {
          "type": "integer",
          "enum": [1, 3],
          "description": "Number of phases (1 or 3)"
        }
      }
    },
    "registeredPerson": {
      "type": "object",
      "required": ["name", "registrationNumber", "registrationType"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of registered electrician"
        },
        "idNumber": {
          "type": "string",
          "pattern": "^\\d{13}$",
          "description": "South African ID number (13 digits)"
        },
        "registrationNumber": {
          "type": "string",
          "description": "Registration number with issuing authority"
        },
        "registrationType": {
          "type": "string",
          "description": "Type of registration",
          "examples": ["Electrical Installation Contractor", "Electrical Tester", "Master Installation Electrician"]
        },
        "registrationDate": {
          "type": "string",
          "format": "date",
          "description": "Date of registration (YYYY-MM-DD)"
        }
      }
    },
    "testResults": {
      "type": "object",
      "description": "Measured test values per SANS 10142-1",
      "properties": {
        "earthResistance": {
          "type": "object",
          "required": ["measured", "unit"],
          "properties": {
            "measured": {
              "type": "number",
              "minimum": 0,
              "description": "Measured earth resistance value"
            },
            "unit": {
              "type": "string",
              "enum": ["Ω", "ohm"],
              "description": "Unit of measurement"
            },
            "testVoltage": {
              "type": "number",
              "description": "Test voltage applied (typically 500V)"
            },
            "testMethod": {
              "type": "string",
              "description": "Test instrument and method used",
              "examples": ["4-pole earth tester", "3-pole earth tester", "Earth loop impedance tester"]
            }
          }
        },
        "insulationResistance": {
          "type": "object",
          "description": "Insulation resistance per circuit",
          "patternProperties": {
            "^circuit\\d+$": {
              "type": "object",
              "required": ["measured", "unit", "testVoltage"],
              "properties": {
                "measured": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Measured insulation resistance (typically in MΩ)"
                },
                "unit": {
                  "type": "string",
                  "enum": ["MΩ", "kΩ", "Ω"],
                  "description": "Unit of measurement"
                },
                "testVoltage": {
                  "type": "number",
                  "enum": [250, 500, 1000],
                  "description": "DC test voltage applied"
                }
              }
            }
          }
        },
        "earthLoopImpedance": {
          "type": "object",
          "description": "Earth fault loop impedance (Zs) measurements",
          "patternProperties": {
            ".*": {
              "type": "object",
              "required": ["measured", "unit", "protectiveDevice", "maxPermitted"],
              "properties": {
                "measured": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Measured Zs value"
                },
                "unit": {
                  "type": "string",
                  "enum": ["Ω", "mΩ"],
                  "description": "Unit of measurement"
                },
                "protectiveDevice": {
                  "type": "string",
                  "description": "Type and rating of protective device",
                  "examples": ["40A Type B MCB", "32A Type C MCB", "63A gG fuse"]
                },
                "maxPermitted": {
                  "type": "number",
                  "description": "Maximum permitted Zs for this device type"
                }
              }
            }
          }
        },
        "rcdTests": {
          "type": "object",
          "description": "RCD trip time tests per SANS 10142-1 Clause 8.8",
          "patternProperties": {
            "^rcd\\d+$": {
              "type": "object",
              "required": ["ratedCurrent", "tripTimeAt1x"],
              "properties": {
                "ratedCurrent": {
                  "type": "number",
                  "enum": [10, 30, 100, 300, 500],
                  "description": "Rated residual operating current (IΔn) in mA"
                },
                "tripTimeAt1x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 300,
                  "description": "Trip time at 1× IΔn (must be ≤ 300ms)"
                },
                "tripTimeAt5x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 40,
                  "description": "Trip time at 5× IΔn (must be ≤ 40ms)"
                },
                "noTripAt50percent": {
                  "type": "boolean",
                  "description": "Verified no trip at 0.5× IΔn (per standard)"
                },
                "unit": {
                  "type": "string",
                  "enum": ["ms"],
                  "description": "Unit for trip times (milliseconds)"
                }
              }
            }
          }
        },
        "polarity": {
          "type": "object",
          "required": ["allCircuits"],
          "properties": {
            "allCircuits": {
              "type": "string",
              "enum": ["Correct", "Incorrect"],
              "description": "Overall polarity status"
            },
            "notes": {
              "type": "string",
              "description": "Additional observations on polarity testing"
            }
          }
        },
        "continuity": {
          "type": "object",
          "required": ["protectiveConductor", "unit"],
          "properties": {
            "protectiveConductor": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "description": "Continuity resistance (must be ≤ 0.5Ω)"
            },
            "unit": {
              "type": "string",
              "enum": ["Ω", "mΩ"],
              "description": "Unit of measurement"
            }
          }
        },
        "voltageDrop": {
          "type": "object",
          "description": "Voltage drop measurements under load",
          "properties": {
            "noLoad": {
              "type": "number",
              "minimum": 220,
              "maximum": 253,
              "description": "No-load voltage (V)"
            },
            "fullLoad": {
              "type": "number",
              "minimum": 207,
              "maximum": 253,
              "description": "Full-load voltage (must be ≤ 253V, max 10% drop)"
            }
          }
        }
      }
    },
    "circuits": {
      "type": "array",
      "minItems": 1,
      "description": "Array of circuit details",
      "items": {
        "type": "object",
        "required": ["circuitNumber", "description", "cableSize", "protectiveDevice", "load"],
        "properties": {
          "circuitNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Circuit identification number"
          },
          "description": {
            "type": "string",
            "description": "Circuit description/purpose",
            "examples": ["Lighting", "Socket outlets", "Geyser", "Stove", "Air conditioner"]
          },
          "cableSize": {
            "type": "number",
            "minimum": 1.0,
            "description": "Conductor cross-sectional area (mm²)"
          },
          "cableSizeUnit": {
            "type": "string",
            "enum": ["mm²", "mm2"],
            "default": "mm²"
          },
          "cableType": {
            "type": "string",
            "description": "Cable type/standard",
            "examples": ["PVC/PVC", "XLPE", "NYM-J", "H07RN-F"]
          },
          "protectiveDevice": {
            "type": "string",
            "description": "Type and rating of protective device",
            "examples": ["16A Type B MCB", "20A Type B MCB", "32A Type C MCB"]
          },
          "load": {
            "type": "number",
            "minimum": 0,
            "description": "Calculated or measured load current (A)"
          },
          "loadUnit": {
            "type": "string",
            "enum": ["A", "kW"],
            "default": "A"
          }
        }
      }
    },
    "installationDate": {
      "type": "string",
      "format": "date",
      "description": "Date installation completed (YYYY-MM-DD)"
    },
    "testDate": {
      "type": "string",
      "format": "date",
      "description": "Date testing performed (YYYY-MM-DD)"
    },
    "specialConditions": {
      "type": "object",
      "description": "Optional special system details",
      "properties": {
        "generator": {
          "type": "object",
          "description": "Generator/backup power details",
          "properties": {
            "installed": {
              "type": "boolean"
            },
            "rating": {
              "type": "number",
              "description": "Generator rating (kVA)"
            },
            "changeoverSwitch": {
              "type": "boolean",
              "description": "Automatic/manual changeover switch installed"
            },
            "backfeedPrevention": {
              "type": "boolean",
              "description": "Backfeed prevention verified"
            }
          }
        },
        "solarPV": {
          "type": "object",
          "description": "Solar photovoltaic system details",
          "properties": {
            "installed": {
              "type": "boolean"
            },
            "capacity": {
              "type": "number",
              "description": "System capacity (kWp)"
            },
            "inverterType": {
              "type": "string",
              "description": "Inverter type/model"
            },
            "dcIsolation": {
              "type": "boolean",
              "description": "DC isolation verified"
            }
          }
        },
        "batteryStorage": {
          "type": "object",
          "description": "Battery energy storage system details",
          "properties": {
            "installed": {
              "type": "boolean"
            },
            "capacity": {
              "type": "number",
              "description": "Battery capacity (kWh)"
            },
            "type": {
              "type": "string",
              "enum": ["Lithium-ion", "Lead-acid", "LiFePO4"],
              "description": "Battery chemistry type"
            },
            "ventilation": {
              "type": "boolean",
              "description": "Adequate ventilation provided"
            }
          }
        },
        "surgeProt": {
          "type": "object",
          "description": "Surge protection device (SPD) details",
          "properties": {
            "installed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": ["Type 1", "Type 2", "Type 3"],
              "description": "SPD classification per IEC 61643"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Installation locations",
              "examples": ["Main DB", "Sub DB", "Generator"]
            }
          }
        }
      }
    }
  }
}
