node_modules
dist
dist-ssr

# Finder/iCloud duplicate-file artifacts ("Dashboard 2.tsx", "node_modules 2/").
# tsconfig.json excludes the same shapes, so they can never inflate the type-error
# ratchet — and deleting them can never be mistaken for fixing type errors.
* 2.*
* 2/

