NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-project-id

# Optional: Cloudflare Turnstile captcha on /auth/login, /signup, /forgot-password.
# Leave unset to disable captcha entirely (form submits proceed without it).
# When set, must also be configured in Supabase Dashboard -> Authentication ->
# Auth Providers -> Captcha protection (Turnstile, with the secret key).
# Site key — public, embedded in the bundle. Secret key lives in Supabase only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
